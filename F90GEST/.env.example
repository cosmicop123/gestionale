# Copiare in .env e personalizzare prima dell'avvio.

# Percorso del database SQLite (relativo alla cartella prisma/ oppure assoluto in Docker)
DATABASE_URL="file:./dev.db"

# Segreto per le sessioni httpOnly — generare con: openssl rand -base64 32
SESSION_SECRET="cambia-questo-segreto-in-produzione"

# SMTP per l'invio email (comunicazioni, notifiche) — usato solo se non è
# stata configurata una casella email "ordinaria" da Amministrazione →
# Email e PEC. Lasciare vuoto in sviluppo.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Associazione Culturale Frequenze 90 <no-reply@example.org>"

# Chiave per cifrare le password delle caselle email/PEC configurate da
# Amministrazione → Email e PEC (mai salvate in chiaro nel database) —
# generare con: openssl rand -base64 32. Obbligatoria solo se si configura
# almeno una casella email dall'interfaccia.
EMAIL_CIFRATURA_SECRET=""

# Cartella di storage per allegati e backup (in Docker: montare come volume)
STORAGE_DIR="./storage"
