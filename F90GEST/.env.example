# Copiare in .env e personalizzare prima dell'avvio.

# Percorso del database SQLite (relativo alla cartella prisma/ oppure assoluto in Docker)
DATABASE_URL="file:./dev.db"

# Segreto per le sessioni httpOnly — generare con: openssl rand -base64 32
SESSION_SECRET="cambia-questo-segreto-in-produzione"

# SMTP per l'invio email (comunicazioni, notifiche) — lasciare vuoto in sviluppo
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Associazione Culturale Frequenze 90 <no-reply@example.org>"

# Cartella di storage per allegati e backup (in Docker: montare come volume)
STORAGE_DIR="./storage"
